generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String?
  businessName        String?
  taxId               String?
  vatId               String?
  taxType             TaxType              @default(KLEINUNTERNEHMER)
  isJobcenter         Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  sessions            Session[]
  transactions        Transaction[]
  taxReserves         TaxReserve[]
  taxProfile          TaxProfile?
  employees           Employee[]
  receivables         Receivable[]
  payables            Payable[]
  fixedCosts          FixedCost[]
  jobcenterRecords    JobcenterRecord[]
  documents           Document[]
  dailyCloses         DailyClose[]
  guidanceCases       GuidanceCase[]
  personaProfile      UserPersonaProfile?
  guidanceTasks       GuidanceTask[]
  decisionEvaluations DecisionEvaluation[]
  purchases           Purchase[]
  entitlements        Entitlement[]
  auditEvents         AuditEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum TaxType {
  KLEINUNTERNEHMER
  REGELBESTEUERUNG
  PAUSCHALIERUNG
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  grossAmount     Decimal         @db.Decimal(12, 2)
  netAmount       Decimal         @db.Decimal(12, 2)
  vatAmount       Decimal         @default(0) @db.Decimal(12, 2)
  vatRate         Decimal         @default(0) @db.Decimal(5, 2)
  description     String?
  merchant        String?
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  usage           ExpenseUsage    @default(BUSINESS)
  businessPct     Int             @default(100)
  businessAmount  Decimal         @db.Decimal(12, 2)
  privateAmount   Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod   @default(BANK)
  documentId      String?
  document        Document?       @relation(fields: [documentId], references: [id])
  aiConfidence    Float?
  isAiClassified  Boolean         @default(false)
  needsReview     Boolean         @default(false)
  transactionDate DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, transactionDate])
  @@index([userId, type])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExpenseUsage {
  BUSINESS
  PRIVATE
  MIXED
  UNSURE
}

enum PaymentMethod {
  BANK
  CASH
  CARD
}

model Category {
  id           String          @id @default(cuid())
  name         String
  nameDe       String?
  skr03Code    String?
  type         TransactionType
  isSystem     Boolean         @default(true)
  transactions Transaction[]
}

model TaxProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  incomeTaxRate        Decimal  @default(30) @db.Decimal(5, 2)
  solidaritySurcharge  Boolean  @default(true)
  churchTax            Boolean  @default(false)
  churchTaxRate        Decimal  @default(9) @db.Decimal(5, 2)
  vatReserveRate       Decimal  @default(19) @db.Decimal(5, 2)
  incomeTaxReserveRate Decimal  @default(30) @db.Decimal(5, 2)
  // USt-Voranmeldung period (§18 UStG). Quarterly is the legal default.
  vatFilingPeriod      VatFilingPeriod @default(QUARTERLY)
  updatedAt            DateTime @updatedAt
}

enum VatFilingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

model TaxReserve {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  type             TaxReserveType
  periodStart      DateTime
  periodEnd        DateTime
  shouldHave       Decimal        @db.Decimal(12, 2)
  actuallyReserved Decimal        @default(0) @db.Decimal(12, 2)
  missing          Decimal        @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, periodStart])
}

enum TaxReserveType {
  VAT
  INCOME_TAX
  TRADE_TAX
}

model Document {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  type                DocumentType
  fileName            String
  r2Key               String
  mimeType            String
  ocrText             String?
  ocrData             Json?
  status              DocStatus     @default(PENDING)
  // Review fields (Sprint 13) — safe nullable additions, no destructive migration
  reviewStatus        String? // PENDING_REVIEW | APPROVED | REJECTED
  approvedAt          DateTime?
  correctionData      Json?
  linkedTransactionId String?
  transactions        Transaction[]
  createdAt           DateTime      @default(now())
}

enum DocumentType {
  RECEIPT
  INVOICE
  BANK_STATEMENT
  OTHER
}

enum DocStatus {
  PENDING
  PROCESSED
  NEEDS_REVIEW
  DONE
}

model FixedCost {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  name       String
  amount     Decimal      @db.Decimal(12, 2)
  usage      ExpenseUsage @default(BUSINESS)
  frequency  Frequency    @default(MONTHLY)
  dayOfMonth Int          @default(1)
  isActive   Boolean      @default(true)
  categoryId String?
  createdAt  DateTime     @default(now())
}

enum Frequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Receivable {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  customerName      String
  description       String?
  totalAmount       Decimal    @db.Decimal(12, 2)
  paidAmount        Decimal    @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal    @db.Decimal(12, 2)
  dueDate           DateTime?
  status            DebtStatus @default(OPEN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Payable {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  supplierName      String
  description       String?
  totalAmount       Decimal    @db.Decimal(12, 2)
  paidAmount        Decimal    @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal    @db.Decimal(12, 2)
  dueDate           DateTime?
  status            DebtStatus @default(OPEN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
}

model Employee {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  name         String
  role         String?
  salaryType   SalaryType        @default(MONTHLY)
  salaryAmount Decimal           @db.Decimal(12, 2)
  isActive     Boolean           @default(true)
  payments     EmployeePayment[]
  createdAt    DateTime          @default(now())
}

model EmployeePayment {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  amount     Decimal   @db.Decimal(12, 2)
  period     DateTime
  paidAt     DateTime?
  isPaid     Boolean   @default(false)
}

enum SalaryType {
  MONTHLY
  HOURLY
}

model JobcenterRecord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  type          JcDocType
  totalIncome   Decimal   @db.Decimal(12, 2)
  totalExpenses Decimal   @db.Decimal(12, 2)
  netProfit     Decimal   @db.Decimal(12, 2)
  freibetrag    Decimal   @default(0) @db.Decimal(12, 2)
  anrechenbares Decimal   @db.Decimal(12, 2)
  status        JcStatus  @default(DRAFT)
  generatedAt   DateTime  @default(now())
}

enum JcDocType {
  EKS
  IKS
}

enum JcStatus {
  DRAFT
  READY
  SUBMITTED
}

model DailyClose {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  date            DateTime  @db.Date
  cashStart       Decimal   @default(0) @db.Decimal(12, 2)
  cashSales       Decimal   @default(0) @db.Decimal(12, 2)
  cashExpenses    Decimal   @default(0) @db.Decimal(12, 2)
  cashEnd         Decimal   @default(0) @db.Decimal(12, 2)
  cashDiff        Decimal   @default(0) @db.Decimal(12, 2)
  missingReceipts Int       @default(0)
  closedAt        DateTime?
  notes           String?
}

enum GuidanceTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum GuidanceTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GuidanceTaskCategory {
  UPLOAD_DOCUMENT
  ADD_TRANSACTION
  CATEGORIZE_EXPENSE
  COMPLETE_PROFILE
  REVIEW_REPORT
  CONTACT_STEUERBERATER
  RESOLVE_CASE
  OTHER
}

model GuidanceTask {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id])
  caseId         String?
  taskKey        String
  title          String
  description    String
  status         GuidanceTaskStatus   @default(OPEN)
  priority       GuidanceTaskPriority @default(MEDIUM)
  category       GuidanceTaskCategory
  relatedSection String?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, taskKey])
  @@index([userId, status])
}

enum GuidanceCaseType {
  FINANZAMT
  JOBCENTER
  PAYMENT
  DOCUMENT_REQUEST
  OTHER
}

enum GuidanceCaseStatus {
  OPEN
  ACTION_REQUIRED
  WAITING_FOR_DOCUMENTS
  READY_FOR_REVIEW
  ESCALATED
  RESOLVED
}

enum GuidanceCaseEventType {
  LETTER_UPLOADED
  OCR_COMPLETED
  DEADLINE_DETECTED
  DOCUMENT_MISSING
  USER_UPLOADED_RECEIPT
  CONFIDENCE_IMPROVED
  ESCALATION_RECOMMENDED
  CASE_RESOLVED
  STATUS_CHANGED
}

model GuidanceCase {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  title                 String
  caseType              GuidanceCaseType
  status                GuidanceCaseStatus  @default(OPEN)
  urgency               String
  openedAt              DateTime            @default(now())
  resolvedAt            DateTime?
  confidenceLevel       String
  preparationStatus     String
  escalationRecommended Boolean             @default(false)
  summary               String
  detectedLetterType    String?
  latestDeadline        DateTime?
  documentId            String?
  events                GuidanceCaseEvent[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

enum BusinessType {
  FREELANCER
  RESTAURANT
  CONSTRUCTION
  DRIVER
  RETAIL
  CREATIVE
  CONSULTANT
  OTHER
}

enum PaymentStyle {
  CASH_HEAVY
  TRANSFER_HEAVY
  MIXED
}

enum GuidanceComplexity {
  SIMPLE
  STANDARD
  ADVANCED
}

enum BureaucracyConfidence {
  LOW
  MEDIUM
  HIGH
}

enum OrganizationLevel {
  OVERWHELMED
  IMPROVING
  ORGANIZED
}

model UserPersonaProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessType        BusinessType @default(OTHER)
  industryCategory    String?
  businessDescription String?

  employeeCount Int @default(0)

  paymentStyle       PaymentStyle @default(MIXED)
  cashPercentage     Int?
  invoicePercentage  Int?
  transferPercentage Int?

  operatingDaysPerWeek   Int?
  averageMonthlyRevenue  Decimal? @db.Decimal(12, 2)
  averageMonthlyExpenses Decimal? @db.Decimal(12, 2)

  seasonalBusiness Boolean @default(false)
  highSeasonMonths String?
  lowSeasonMonths  String?

  guidanceComplexity    GuidanceComplexity    @default(STANDARD)
  bureaucracyConfidence BureaucracyConfidence @default(MEDIUM)
  organizationLevel     OrganizationLevel     @default(IMPROVING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuidanceCaseEvent {
  id          String                @id @default(cuid())
  caseId      String
  case        GuidanceCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType   GuidanceCaseEventType
  title       String
  description String
  metadata    Json?
  createdAt   DateTime              @default(now())
}

model DecisionEvaluation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  decisionType    String
  amount          Decimal  @db.Decimal(12, 2)
  purpose         String
  note            String?
  resultLevel     String
  confidenceLevel String
  summary         String
  reasons         Json
  missingData     Json?
  obligations     Json?
  riskSignals     Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Monetization (Sprint 15.1) ──────────────────────────────────────────────
// Architecture: Option C — Purchase (ledger) → Entitlement (derived projection).
//   Purchase     = immutable financial record. Source of truth for audit,
//                  refunds, and the Kleinunternehmer §19 receipt note.
//   Entitlement  = access projection. Written ONLY by the verified Stripe webhook
//                  (Sprint 15.3). Gating reads Entitlement by FEATURE, never by SKU.
//                  KOMPLETT grants both FINANZAMT + PREPARATION rows.
// Future Human Review (consumable) slots in by adding a ProductSku value plus a
// separate ServiceOrder model later — no change to these two tables required.

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku                     ProductSku
  amountCents             Int
  currency                String         @default("eur")
  status                  PurchaseStatus @default(PENDING)
  // Stripe linkage (populated from Sprint 15.2/15.3 onward; nullable now).
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  stripeCustomerId        String?
  lastEventId             String? // last Stripe event id applied — replay guard
  taxNote                 String         @default("Gemäß §19 UStG wird keine Umsatzsteuer berechnet.")
  paidAt                  DateTime?
  refundedAt              DateTime?
  entitlements            Entitlement[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([userId, status])
}

model Entitlement {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature    EntitlementFeature
  source     EntitlementSource  @default(PURCHASE)
  active     Boolean            @default(true)
  purchaseId String?
  purchase   Purchase?          @relation(fields: [purchaseId], references: [id])
  grantedAt  DateTime           @default(now())
  revokedAt  DateTime?

  @@unique([userId, feature]) // one grant per feature per user — blocks escalation/dupes
  @@index([userId, active])
}

enum ProductSku {
  FINANZAMT_ASSISTENT // 49€  → grants FINANZAMT
  STEUERBERATER_VORBEREITUNG // 99€  → grants PREPARATION
  KOMPLETT // 149€ → grants FINANZAMT + PREPARATION
  // HUMAN_REVIEW reserved for a future consumable SKU — do NOT add until that sprint.
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum EntitlementFeature {
  FINANZAMT
  PREPARATION
}

enum EntitlementSource {
  PURCHASE
  COMP
  MANUAL
}

// ── Audit trail ─────────────────────────────────────────────────────────────
// Append-only history of financially relevant changes: manual edits, receipt
// approvals/corrections, imports, reserve updates. `before`/`after` hold the
// changed fields only. Never updated or deleted except with the whole account.
model AuditEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String // TRANSACTION | DOCUMENT | TAX_RESERVE | ACCOUNT | ...
  entityId   String
  action     String // CREATE | UPDATE | DELETE | APPROVE | REJECT | IMPORT | EXPORT
  source     String   @default("USER") // USER | AI | IMPORT | SYSTEM
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([userId, entityType, entityId])
  @@index([userId, createdAt])
}
