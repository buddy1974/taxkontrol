# Copy to .env.local. NEVER point a local .env at the production database.
# Local: postgresql://taxkontrol:taxkontrol_test@localhost:55440/taxkontrol_dev (npm run test:db:up)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/taxkontrol"

# Auth.js — generate with: openssl rand -base64 32 (different per environment)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:2011"
AUTH_URL="http://localhost:2011"

# Document storage (Cloudflare R2)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY=""
CLOUDFLARE_R2_SECRET_KEY=""
CLOUDFLARE_R2_BUCKET=""

# AI reading of receipts / statements (suggestions only). Model is optional.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"

# Shared rate limiting across serverless instances (optional, recommended in production)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Contact form delivery (without these the form answers 503 — nothing is lost silently)
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# Paid features — keep off until checkout exists and tiers are decided
# ENTITLEMENTS_ENFORCED="false"

# Local review mode — only with NODE_ENV=development AND a local DATABASE_URL; ignored on Vercel
DEV_BYPASS_LOGIN=false
DEV_BYPASS_EMAIL=test@taxkontrol.local

# Tests (defaults shown) — must be local databases
# TEST_DATABASE_URL="postgresql://taxkontrol:taxkontrol_test@localhost:55440/taxkontrol_test"
# SHADOW_DATABASE_URL="postgresql://taxkontrol:taxkontrol_test@localhost:55440/taxkontrol_shadow"

# Seeding: demo data is local-only; system categories on a remote DB need SEED_CONFIRM_REMOTE=<host>
# SEED_DEMO_PASSWORD=""
